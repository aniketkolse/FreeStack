{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FreeStack Discovery & Verification Source Registry",
  "description": "Permitted official discovery and verification sources aligned with Sections 8, 10, and 11 of the Master Blueprint",
  "type": "object",
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "domain",
          "entry_url",
          "source_type",
          "category",
          "crawl_policy",
          "active"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 2 },
          "domain": { "type": "string", "minLength": 3 },
          "entry_url": { "type": "string", "format": "uri" },
          "source_type": {
            "type": "string",
            "enum": [
              "official_pricing",
              "official_docs",
              "student_page",
              "curated_registry",
              "official_repo"
            ]
          },
          "category": { "type": "string" },
          "crawl_policy": {
            "type": "object",
            "required": ["respect_robots_txt", "rate_limit_rpm", "max_retries", "primary_fetcher"],
            "properties": {
              "respect_robots_txt": { "type": "boolean", "const": true },
              "rate_limit_rpm": { "type": "integer", "minimum": 1, "maximum": 30 },
              "max_retries": { "type": "integer", "minimum": 1, "maximum": 5 },
              "primary_fetcher": { "type": "string", "enum": ["crawl4ai", "scrapling", "http_head"] }
            }
          },
          "active": { "type": "boolean" }
        }
      }
    }
  }
}

# =============================================================================
# FreeStack — Environment Configuration (.env.example)
# Copy to .env for local overrides: cp .env.example .env
# NEVER commit a real .env file or secret tokens to Git.
# =============================================================================

# Runtime mode: "development" | "production"
NODE_ENV="development"

# HTTP bind address and port (default: 0.0.0.0:3000)
HOST="0.0.0.0"
PORT="3000"

# Canonical public HTTPS origin (REQUIRED when NODE_ENV="production").
# Used to build /sitemap.xml, /robots.txt, canonical/OG URLs, and HTTPS redirects
# without trusting the incoming HTTP Host header.
SITE_URL="https://freestack.example.com"

# Reverse proxy hop count or boolean for express-rate-limit and HTTPS detection.
# Set to "1" when running behind a single reverse proxy / Cloudflare / load balancer.
TRUST_PROXY="1"

# Path to the server-side community reports queue JSON file (untracked in Git).
REPORTS_PATH="./data/reports.json"

# Optional maintainer bearer token (minimum 32 characters) required to access
# GET /api/reports. If unset or shorter than 32 chars, GET /api/reports is disabled (404).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=""
